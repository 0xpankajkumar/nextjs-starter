#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Running pre-commit checks (prettier, eslint, types)..."

pnpm run prettier:check || {
  echo "Prettier check failed. Run 'pnpm run prettier:format', stage the changes and commit again."
  exit 1
}

pnpm run lint:check || {
  echo "ESLint check failed. Fix the errors listed above, stage the changes and commit again."
  exit 1
}

pnpm run types:check || {
  echo "Type check failed. Fix the type errors listed above and commit again."
  exit 1
}

echo "All checks passed."
